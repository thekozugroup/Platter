# Platter configuration.
#
# Every value here has a working default — copying this file is optional. Platter starts with an
# empty environment and creates ~/.platter on first run.
#
# The authoritative list, with explanations, is packages/shared/src/env.ts.

# --- Where Platter keeps everything ------------------------------------------
# The database, every world, every backup and the mod cache. One directory to back up, one to
# delete to start over.
# PLATTER_DATA_DIR=~/.platter

# --- Web UI -------------------------------------------------------------------
# PLATTER_PORT=4880
#
# Bind address. Loopback by default. Setting this to anything else REQUIRES PLATTER_AUTH_TOKEN —
# Platter refuses to start otherwise, because socket access is root-equivalent on the host.
# See SECURITY.md.
# PLATTER_HOST=127.0.0.1
#
# Shared secret for the UI and its API. Generate with: openssl rand -base64 32
# Present it once in a browser as ?token=..., or as `Authorization: Bearer ...` from a script.
# PLATTER_AUTH_TOKEN=

# --- Game server ports --------------------------------------------------------
# The range Platter hands out. Widen it if you run more than ~100 servers.
# PLATTER_PORT_RANGE_START=25565
# PLATTER_PORT_RANGE_END=25664
#
# Interface published game ports bind to. 0.0.0.0 lets people on your LAN join, which is the
# point. RCON is always pinned to loopback regardless of this.
# PLATTER_BIND_ADDRESS=0.0.0.0

# --- Docker -------------------------------------------------------------------
# Overridden by DOCKER_HOST if that is set, so Colima / Rancher / OrbStack users usually need
# nothing here.
# PLATTER_DOCKER_SOCKET=/var/run/docker.sock
#
# Dedicated bridge network for game containers, created if missing. Keeps servers off the
# default bridge where they could reach each other's RCON ports.
# PLATTER_DOCKER_NETWORK=platter
#
# Point at a private mirror or an air-gapped registry. Must publish the same java* tags.
# PLATTER_MINECRAFT_IMAGE_REPO=itzg/minecraft-server
# PLATTER_BACKUP_IMAGE_REPO=itzg/mc-backup
#
# Allow images outside Platter's allowlist. This makes Platter able to run anything, which on a
# Docker socket means anything on your host. Read SECURITY.md before setting it.
# PLATTER_ALLOW_CUSTOM_IMAGES=0

# --- Mod providers ------------------------------------------------------------
# Optional. Modrinth works anonymously; a token raises the rate limit.
# Create one at https://modrinth.com/settings/pats
# MODRINTH_TOKEN=
#
# Required for any CurseForge feature. Without it, Platter searches Modrinth only rather than
# failing halfway through a search. Request one at https://console.curseforge.com
# CURSEFORGE_API_KEY=

# --- MCP server ---------------------------------------------------------------
# Only used by the HTTP transport; the stdio transport needs none of this.
# PLATTER_MCP_HOST=127.0.0.1
# PLATTER_MCP_PORT=4881
#
# Generated and stored in $PLATTER_DATA_DIR/mcp-token on first run if unset.
# PLATTER_MCP_TOKEN=

# --- Behaviour ----------------------------------------------------------------
# PLATTER_LOG_LEVEL=info
# Seconds between reconciling container state against the database.
# PLATTER_POLL_INTERVAL_SECONDS=5
# Turn off the automatic backup taken before mod installs and rollbacks. Not recommended.
# PLATTER_DISABLE_AUTO_BACKUP=0
