# Copy to `.env` and edit. Only JWT_SECRET is strictly required.
#
#   cp .env.example .env
#   openssl rand -base64 48        # paste as JWT_SECRET
#   stat -c '%g' /var/run/docker.sock   # paste as DOCKER_GID
#   docker compose up -d

# --- Required -----------------------------------------------------------------

# Signs access and refresh tokens. Changing it invalidates every existing session,
# which is exactly what you want if it ever leaks.
JWT_SECRET=

# --- Networking ---------------------------------------------------------------

# The port Platter's web interface listens on.
PLATTER_PORT=8080

# The hostname or IP players use to reach your game servers. This is what Platter shows
# as each server's address — set it to your public DNS name or WAN address, not localhost,
# unless you are only playing on this machine.
PUBLIC_HOST=127.0.0.1

# Host port range Platter allocates game server ports from. Make sure these are forwarded
# and not already in use; one server typically takes two or three.
PORT_RANGE_START=25000
PORT_RANGE_END=25999

# --- Docker access ------------------------------------------------------------

# GID of the group owning /var/run/docker.sock on the host. Platter runs unprivileged and
# needs this group to talk to the daemon. Find it with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- AI (optional) ------------------------------------------------------------

# Without a key, AI features are hidden rather than broken — everything else works.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# --- Behaviour ----------------------------------------------------------------

# Off by default: on a self-hosted panel, open registration means anyone who finds the
# URL can create an account. Invite users from the admin area instead.
REGISTRATION_ENABLED=false

# Creates the default node and the first owner account on first boot. The generated
# password is printed to the container log exactly once — read it with `docker compose logs`.
SEED_ON_START=1

LOG_LEVEL=info

# --- Postgres (optional) ------------------------------------------------------
# Uncomment the postgres service in docker-compose.yml, then set both of these.
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://platter:PASSWORD@postgres:5432/platter
