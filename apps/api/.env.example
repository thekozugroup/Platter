# Platter API configuration.
#
# Copy to `.env` and edit. Every key below is optional except JWT_SECRET in production;
# the defaults shown are what the API uses when the key is absent, and they are tuned so
# that a bare `docker run` works with no external services.

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

# development | test | production. Production refuses weak defaults (see JWT_SECRET).
NODE_ENV=development

# Port the HTTP API listens on.
PORT=8080

# Bind address. 0.0.0.0 inside a container, 127.0.0.1 if you terminate TLS in front.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite by default so there is nothing else to run. Relative paths are resolved by
# Prisma against the `prisma/` directory, so `file:./data/platter.db` lands in
# apps/api/prisma/data/. Postgres is a supported swap: change the datasource provider in
# prisma/schema.prisma and set a postgresql:// URL here.
DATABASE_URL=file:./data/platter.db

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signing key for access tokens. Minimum 32 characters. Required in production — the
# process refuses to start without it. In development a random secret is generated per
# run, which means every restart signs everyone out.
#   openssl rand -hex 32
JWT_SECRET=

# How long an access token is valid. Held in memory by the SPA and refreshed early.
ACCESS_TOKEN_TTL=15m

# How long a refresh token is valid. Refresh tokens live in an httpOnly cookie and are
# rotated on every use; replaying a rotated token revokes the whole login family.
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root for server volumes and any other durable state. Mount this as a volume.
DATA_DIR=./data

# Where backup archives are written. Point this at different storage if backups should
# not share a disk with the live game data.
BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------------
# Orchestration
# ---------------------------------------------------------------------------

# Docker daemon socket, bind-mounted into the container in the default deployment.
DOCKER_SOCKET=/var/run/docker.sock

# docker | mock. `mock` runs the in-memory driver — no daemon, useful for demos and CI.
DEFAULT_NODE_DRIVER=docker

# Hostname or IP players use to reach game servers on the default node.
PUBLIC_HOST=127.0.0.1

# Inclusive host port range Platter may auto-allocate game ports from. Publish this
# range from the container.
PORT_RANGE_START=25000
PORT_RANGE_END=25999

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Anthropic API key. Leave empty to run without AI: the assistant, natural-language
# provisioning and crash triage advertise themselves as unavailable and the UI hides them.
ANTHROPIC_API_KEY=

# Model used for provisioning proposals, crash diagnosis and chat.
AI_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Trust X-Forwarded-* headers. false when Platter is directly exposed; true or a hop
# count (e.g. 1) or a CIDR list when it sits behind a reverse proxy. Getting this wrong
# either hides the real client IP from the audit log or lets clients forge it.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API with credentials. Leave empty
# when the SPA is served from the same origin as the API (the default deployment).
# Example for a separate Vite dev server: http://localhost:5173
CORS_ORIGINS=

# Requests per minute per client for normal routes. Authentication routes use a much
# stricter bucket that is not configurable here.
RATE_LIMIT_MAX=300

# Allow anyone to create an account. The very first account is always allowed regardless
# of this setting, and is created as `owner`.
REGISTRATION_ENABLED=false

# Expose Prometheus metrics.
METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# Mod registries
# ---------------------------------------------------------------------------

# Read directly by `src/mods/*` rather than through `config.ts`, because they are optional
# and only that subsystem uses them.

# CurseForge API key. Without one, only Modrinth is searched — CurseForge is simply absent
# from the source list rather than failing.
CURSEFORGE_API_KEY=

# How to reach whoever runs this install. Modrinth asks busy clients to identify
# themselves in the User-Agent; setting it earns a warning instead of a block.
PLATTER_CONTACT=

# Point the Modrinth client at a mirror, a caching proxy, or an internal instance.
# Leave empty for the public API (https://api.modrinth.com/v2). Note that mod downloads
# are still restricted to the registry's own file hosts, which is deliberate: the download
# host allowlist in `src/mods/install.ts` is what stops a compromised API response from
# pointing the installer at an arbitrary server.
MODRINTH_BASE_URL=

# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------

# Only read by the stdio MCP entry point (`src/mcp/cli.ts`), which an MCP client spawns as
# a subprocess. The HTTP transport at `/api/v1/mcp` takes the key per request instead.
PLATTER_API_KEY=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------

# Read only by `prisma/seed.ts`, and only when the database has no owner account yet.
# Leave SEED_PASSWORD empty and the seed generates a strong one and prints it once — there
# is deliberately no default credential. SEED_PASSWORD is held to the same strength rule
# the API enforces on a password set through the UI.
SEED_EMAIL=
SEED_PASSWORD=
