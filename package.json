{
  "name": "platter",
  "version": "0.1.0",
  "private": true,
  "description": "Simple, clean, easily deployable game servers driven by AI",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter @platter/shared build && pnpm -r --filter @platter/api --filter @platter/web build",
    "dev": "pnpm --parallel --filter @platter/api --filter @platter/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yaml,yml}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @platter/web test:e2e",
    "db:generate": "pnpm --filter @platter/api db:generate",
    "db:migrate": "pnpm --filter @platter/api db:migrate",
    "db:seed": "pnpm --filter @platter/api db:seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "prisma", "esbuild", "cpu-features", "ssh2"]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
