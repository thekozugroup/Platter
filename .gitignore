node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Platter runtime data (servers, worlds, backups, sqlite db)
/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Env
.env
.env.local
.env.*.local
!.env.example

# Logs
#
# Anchored to the repository root rather than matching at any depth: an unanchored `*.log`
# silently swallowed every log fixture in packages/diagnostics, and a test corpus that vanishes
# on clone is the kind of thing nobody notices until the rules stop being tested.
/*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/
test-results/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
Thumbs.db

# Local CA used only when validating the Docker build behind a TLS-inspecting proxy
docker/.ca-test.crt
